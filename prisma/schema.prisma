datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(USER)
  reviews   Review[]
  createdAt DateTime @default(now())
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id           String           @id @default(cuid())
  title        String
  slug         String           @unique
  description  String
  price        Float
  salePrice    Float?
  images       String[]
  isAvailable  Boolean          @default(true)
  isBestseller Boolean          @default(false)
  dietaryTags  String[]         // e.g. ["Eggless", "Gluten-Free"]
  categoryId   String
  category     Category         @relation(fields: [categoryId], references: [id])
  variants     ProductVariant[]
  reviews      Review[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model ProductVariant {
  id        String  @id @default(cuid())
  name      String  // e.g., "500g", "Box of 6"
  price     Float
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  userName   String
  rating     Int
  comment    String
  isApproved Boolean  @default(false)
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model SiteSettings {
  id                    String  @id @default("default")
  whatsappNumber        String  @default("+1234567890")
  supportEmail          String  @default("orders@dessertyhouse.com")
  heroTitle             String  @default("Freshly Baked Happiness")
  heroSubtitle          String  @default("Artisanal treats made fresh daily. Order directly via WhatsApp!")
  announcementText      String? @default("Orders delivered daily! Chat with us on WhatsApp to customize.")
  announcementActive    Boolean @default(true)
  
  // Automation Feature Flags (Default OFF)
  enableAutomatedEmails Boolean @default(false)
  enableOnlinePayments  Boolean @default(false)
  enableAutoOrderTrack  Boolean @default(false)
}
